# ── Copy this file to .env and fill in your values ────────────────────────────
# cp .env.example .env

# ── OpenAI API ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here

# ── LLM Settings ─────────────────────────────────────────────────────────────
LLM_MODEL=gpt-3.5-turbo
LLM_TEMPERATURE=0.2
MAX_TOKENS=512

# ── Embedding Model ───────────────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small

# ── Vector Store ─────────────────────────────────────────────────────────────
VECTORSTORE_TYPE=faiss           # faiss | chroma
VECTORSTORE_PATH=vectorstore/faiss_index

# ── Documents ─────────────────────────────────────────────────────────────────
DOCS_DIR=data/sample_docs
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# ── Retrieval ─────────────────────────────────────────────────────────────────
TOP_K_DOCS=4

# ── API Server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
